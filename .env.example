# Copy this file to .env.local for local development.
# In Vercel: Project Settings -> Environment Variables (never commit real values).

# Public site URL, used for metadata/canonical links and social share previews.
NEXT_PUBLIC_SITE_URL=https://ardafispartners.com

# Contact form email delivery (https://resend.com — free tier available).
# Leave unset and the contact form will still accept submissions and log
# them server-side without emailing anyone (safe default, nothing breaks).
RESEND_API_KEY=
CONTACT_EMAIL_TO=contact@ardafispartners.com

# Search engine ownership verification (optional).
# Google Search Console: Settings -> Ownership verification -> HTML tag -> copy the content value only.
# Bing Webmaster Tools: same idea, via the meta tag verification option.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
